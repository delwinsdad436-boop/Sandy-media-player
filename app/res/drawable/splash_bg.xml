<?xml version="1.0" encoding="utf-8"?>
<!-- Boot-screen window background: the art's own navy, with the
     picture centered. The art carries navy margins in the same color,
     so any letterboxing is invisible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#051226" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/splash_art"
            android:gravity="center"
            android:tileMode="disabled" />
    </item>
</layer-list>
