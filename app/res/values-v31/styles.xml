<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ platform splash: same navy, same icon, so the
         system splash hands into the boot screen without a jolt. -->
    <style name="SplashTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">#051226</item>
        <item name="android:navigationBarColor">#051226</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">#051226</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
