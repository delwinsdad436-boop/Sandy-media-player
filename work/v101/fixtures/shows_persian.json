mmary": "<p>The history of Iran, with all its ups and downs, takes place in the life of every single Iranian, and the historical series \"Khatoon\" also deals with a story about this; The story of the sub-families whose story began in early September 1941 and underwent changes during the Allied occupation of Iran.</p>", "updated": 1660806280, "_links": {"self": {"href": "https://api.tvmaze.com/shows/57351"}, "previousepisode": {"href": "https://api.tvmaze.com/episodes/2277663", "name": "Episode 23"}}}, {"id": 57884, "url": "https://www.tvmaze.com/shows/57884/red-square", "name": "Red Square", "type": "Scripted", "language": "Persian", "genres": [], "status": "Running", "runtime": 60, "averageRuntime": 60, "premiered": "2021-09-17", "ended": null, "officialSite": "https://www.meidanesorkh.com/", "schedule": {"time": "12:00", "days": ["Friday"]}, "rating": {"average": null}, "weight": 60, "network": null, "webChannel": {"id": 507, "name": "filimo", "country": {"name": "Iran, Islamic Republic of", "code": "IR", "timezone": "Asia/Tehran"}, "officialSite": null}, "dvdCountry": null, "externals": {"tvrage": null, "thetvdb": 404506, "imdb": "tt14562826"}, "image": {"medium": "https://static.tvmaze.com/uploads/images/medium_portrait/360/900478.jpg", "original": "https://static.tvmaze.com/uploads/images/original_untouched/360/900478.jpg"}, "summary": "<p><b>Red Square</b> is the story of a lonely woman named Sheida who inadvertently enters a horrific game created by her husband and a foreign terrorist. To save her daughter's life, she is faced with a choice between love, revenge and power, and for a while she accompanies three prominent and powerful smugglers named Pop, Mobini and Makin, unaware that the end of this game will be bloody.</p>", "updated": 1633707911, "_links": {"self": {"href": "https://api.tvmaze.com/shows/57884"}, "previousepisode": {"href": "https://api.tvmaze.com/episodes/2189836", "name": "Episode 20"}}}, {"id": 59536, "url": "https://www.tvmaze.com/shows